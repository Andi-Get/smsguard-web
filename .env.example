# Public URL encoded into device pairing QR codes. Set this to a LAN address
# (for example http://192.168.1.20:3000) when testing with a real phone.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres (docker compose up -d)
DATABASE_URL=postgresql://smsguard:smsguard@localhost:5432/smsguard
